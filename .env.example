# CineCloud Configuration
PORT=8080
HOST=0.0.0.0
DEBUG=false
SECRET_KEY=cinecloud-secure-production-key-2026

# Storage Driver: 'local' or 's3'
STORAGE_DRIVER=local

# AWS S3 / Cloudflare R2 / MinIO Settings (Optional)
S3_BUCKET_NAME=
S3_ENDPOINT_URL=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1

# Video Processing & Transcoding
FFMPEG_PATH=ffmpeg
ENABLE_TRANSCODING=false
